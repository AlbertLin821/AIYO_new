generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String                  @id @default(cuid())
  email          String                  @unique
  name           String?
  image          String?
  emailVerified  DateTime?
  passwordHash   String?                 @db.Text
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt
  profile        Profile?
  trips          Trip[]
  itineraryFolders ItineraryFolder[]
  tripCollaborations TripCollaborator[]
  tripPublications TripPublication[]
  chatMessages   ChatMessage[]
  videoInteractions VideoInteraction[]
  appliedVideoSummaries AppliedVideoSummary[]
  comments       Comment[]
  presences      CollaborationPresence[]
  accounts       Account[]
  sessions       Session[]

  @@map("users")
}

model Profile {
  id          String   @id @default(cuid())
  userId      String   @unique
  budget      Int?
  destination String?
  preferences Json?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Trip {
  id          String        @id @default(cuid())
  userId      String
  folderId    String?
  title       String
  coverImageUrl String?
  destination String?
  days        Int
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder      ItineraryFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  itineraryDays TripDay[]
  items       TripItem[]
  pins        MapPin[]
  chatMessages ChatMessage[]
  room        CollaborationRoom?
  collaborators TripCollaborator[]
  publication TripPublication?
  videoInteractions VideoInteraction[]
  appliedVideoSummaries AppliedVideoSummary[]

  @@index([userId, updatedAt])
  @@index([folderId])
  @@map("trips")
}

model TripPublication {
  id             String    @id @default(cuid())
  tripId         String    @unique
  publisherId    String
  title          String
  coverImageUrl  String?
  days           Int
  destination    String?
  searchText     String    @default("")
  snapshotJson   Json
  publisherImage String?
  publishedAt    DateTime  @default(now())
  revokedAt      DateTime?

  trip           Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  publisher      User      @relation(fields: [publisherId], references: [id], onDelete: Cascade)

  @@index([publishedAt(sort: Desc)])
  @@index([publisherId])
  @@map("trip_publications")
}

model ItineraryFolder {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trips     Trip[]

  @@index([userId])
  @@map("itinerary_folders")
}

model TripCollaborator {
  id        String   @id @default(cuid())
  tripId    String
  userId    String
  role      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId])
  @@index([tripId])
  @@index([userId])
  @@map("trip_collaborators")
}

model TripDay {
  id        String   @id @default(cuid())
  tripId     String
  dayNumber  Int
  theme      String?
  summary    String?
  sortOrder  Int
  trip       Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, dayNumber])
  @@index([tripId, sortOrder])
  @@map("trip_days")
}

model TripItem {
  id               String   @id @default(cuid())
  tripId           String
  day              Int
  title            String
  description      String?
  timeSlot         String?
  itemType         String?
  transportMode    String?
  transportDurationMinutes Int?
  transportDistanceMeters Int?
  transportDataSource String?
  source           String?
  location         String?
  latitude         Float?
  longitude        Float?
  locationDesc     String?
  locationAddress  String?
  placeId          String?
  photoUrl         String?
  thumbnail        String?
  openingHours     String?
  phoneNumber      String?
  website          String?
  googleMapsUrl    String?
  rating           Float?
  userRatingsTotal Int?
  confidence       Float?
  verified         Boolean?
  order            Int
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, day, order])
  @@map("trip_items")
}

model MapPin {
  id               String   @id @default(cuid())
  tripId           String
  label            String
  lat              Float
  lng              Float
  description      String?
  address          String?
  placeId          String?
  photoUrl         String?
  thumbnail        String?
  openingHours     String?
  phoneNumber      String?
  website          String?
  googleMapsUrl    String?
  rating           Float?
  userRatingsTotal Int?
  color            String?
  source           String?
  confidence       Float?
  verified         Boolean?
  linkedTripItemId String?
  dayNumber        Int?
  trip             Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("map_pins")
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  tripId    String?
  role      String
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip      Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tripId, createdAt])
  @@map("chat_messages")
}

model VideoSummaryCache {
  id        String   @id @default(cuid())
  videoId   String   @unique
  result    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("video_summary_caches")
}

model VideoInteraction {
  id              String   @id @default(cuid())
  userId          String
  tripId          String?
  videoId         String
  source          String?
  videoUrl        String?
  title           String?
  interactionType String
  analysisId      String?
  summaryId       String?
  watchDurationSeconds Int?
  progress        Float?
  extractedPlaces Json?
  extractedTimestamps Json?
  metadata        Json?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip            Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([tripId, createdAt])
  @@index([videoId])
  @@map("video_interactions")
}

model AppliedVideoSummary {
  id               String   @id @default(cuid())
  userId           String
  tripId           String?
  videoId          String
  summaryId        String?
  videoUrl         String?
  title            String?
  appliedPlaces    Json?
  appliedSegments  Json?
  createdTripItems Json?
  summarySnapshot  Json?
  appliedAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip             Trip?    @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@index([userId, appliedAt])
  @@index([tripId, appliedAt])
  @@index([videoId])
  @@map("applied_video_summaries")
}

model CollaborationRoom {
  id         String                  @id @default(cuid())
  tripId      String                  @unique
  inviteCode  String                  @unique
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  trip        Trip                    @relation(fields: [tripId], references: [id], onDelete: Cascade)
  comments    Comment[]
  presences   CollaborationPresence[]

  @@map("collaboration_rooms")
}

model Comment {
  id        String            @id @default(cuid())
  roomId     String
  authorId   String
  content    String
  createdAt  DateTime          @default(now())
  room       CollaborationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  author     User              @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
  @@map("comments")
}

model CollaborationPresence {
  id               String            @id @default(cuid())
  roomId            String
  userId            String
  activeSection     String?
  selectedEntityId  String?
  /** 行程頁游標預覽區座標（百分比 0–100） */
  cursorX          Float?
  cursorY          Float?
  online            Boolean           @default(true)
  lastSeenAt        DateTime          @default(now())
  room              CollaborationRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([roomId, lastSeenAt])
  @@map("collaboration_presence")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}
