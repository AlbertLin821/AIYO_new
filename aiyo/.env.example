OLLAMA_BASE_URL=http://localhost:11434

# --- Ollama 推薦配置（本機已安裝對應模型時）---
# 聊天 / 結構化 JSON：qwen3.5:9b（穩定、繁中佳）
# 完整行程 JSON：granite4.1:3b（較小、少占 VRAM）
# 影片摘要：granite4.1:8b + 快速 pass 用 mistral-small:24b
# Mem0 嵌入：nomic-embed-text（由 mem0-memory 容器設定，見 docker-compose）
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TRAVEL_CHAT_MODEL=qwen3.5:9b
OLLAMA_TRIP_PLAN_MODEL=granite4.1:3b
OLLAMA_VIDEO_SUMMARY_MODEL=granite4.1:8b
OLLAMA_VIDEO_SUMMARY_FAST_MODEL=mistral-small:24b
OLLAMA_VIDEO_SUMMARY_FINAL_MODEL=granite4.1:8b
OLLAMA_LOCATION_MODEL=granite4.1:8b
VIDEO_EXTRACTION_MODE=simple-ollama
OLLAMA_TIMEOUT_MS=120000
OLLAMA_TIMEOUT_CAP_MS=600000
OLLAMA_TIMEOUT_RETRY_COUNT=1
OLLAMA_TIMEOUT_RETRY_DELAY_MS=400
OLLAMA_THINK=false
OLLAMA_VIDEO_THINK=true
OLLAMA_VIDEO_SEGMENT_JSON_POLISH=true
OLLAMA_VIDEO_LOCATION_JSON_FILTER=false
VIDEO_EXTRACTION_CHUNK_MAX_CHARS=12000
VIDEO_EXTRACTION_CHUNK_OVERLAP_CHARS=500
VIDEO_EXTRACTION_CHUNK_MAX_COUNT=8
VIDEO_EXTRACTION_CHUNK_CONCURRENCY=1
VIDEO_EXTRACTION_OPTIONAL_VERIFY=false
MEM0_BASE_URL=http://localhost:8890
MEM0_ENABLED=true
MEM0_TOP_K=5
MEM0_TIMEOUT_MS=12000
DATABASE_URL=postgresql://aiyo:aiyo_password@localhost:5432/aiyo_new_db?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_NAME=AIYO
YOUTUBE_API_KEY=
GOOGLE_MAPS_API_KEY=
# Optional: Tavily web search for travel chat research, local events, and map segment hints (https://tavily.com).
TAVILY_API_KEY=
# AI 旅遊搜尋：auto | serper | tavily。auto 時優先 Serper，其次 Tavily。
WEB_SEARCH_PROVIDER=auto
SERPER_API_KEY=
AIYO_WEB_SEARCH_MOCK=false
SEARXNG_BASE_URL=http://localhost:8081
SEARXNG_INTERNAL_BASE_URL=http://searxng:8080
# AI 聊天搜尋走 Serper/Tavily；SearXNG 僅實驗用，建議關閉。
SEARXNG_ENABLED=false
SEARXNG_TIMEOUT_MS=12000
SEARXNG_DEFAULT_LANGUAGE=zh-TW
SEARXNG_DEFAULT_CATEGORIES=general
SEARXNG_RESULT_LIMIT=8
SEARXNG_SAFE_SEARCH=1
AI_WEB_SEARCH_ENABLED=true
AI_WEB_SEARCH_MAX_RESULTS=6
AI_WEB_SEARCH_REQUIRE_CITATIONS=true
# Must match GOOGLE_MAPS_API_KEY. If .env.local exists it overrides .env — keep both files in sync.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: real Map ID from Cloud Console (Map Management). Do not paste env var names as placeholders.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
ENABLE_MOCK_VIDEO_PROVIDER=false
ENABLE_MOCK_MAPS=false
VIDEO_PLACE_REQUIRE_VERIFICATION=true
VIDEO_PLACE_ALLOW_HEURISTIC_FALLBACK=false
VIDEO_PLACE_ENABLE_OLLAMA_CANDIDATES=true
VIDEO_PLACE_ENABLE_NOMINATIM=false
VIDEO_PLACE_MAX_CANDIDATES=24
VIDEO_PLACE_MAX_FINAL_PLACES=16
