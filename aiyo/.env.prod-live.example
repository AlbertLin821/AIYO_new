NODE_ENV=production
AIYO_ENV_MODE=prod-live
AIYO_ENV_FILE=.env.prod-live
PORT=3000
HOSTNAME=0.0.0.0

NEXTAUTH_URL=http://127.0.0.1:3001
NEXTAUTH_SECRET=replace-with-prod-live-nextauth-secret

DATABASE_URL=postgresql://aiyo:aiyo_password_change_me@aiyo-new-postgres-prod:5432/aiyo_new_prod_db?schema=public
REDIS_URL=redis://aiyo-new-redis:6379/0

OPENWEBUI_BASE_URL=http://open-webui:8080
OPENWEBUI_API_KEY=
OPENWEBUI_MODEL=granite4.1:8b
OPENWEBUI_PUBLIC_URL=http://127.0.0.1:8080
OPENWEBUI_ENV=prod
OPENWEBUI_SECRET_KEY=replace-with-a-long-random-secret
OPENWEBUI_ADMIN_EMAIL=admin@aiyo.local
OPENWEBUI_ADMIN_PASSWORD=ChangeThisOpenWebUiAdminPassword123!
OPENWEBUI_ADMIN_NAME=AIYO Admin
OPENWEBUI_ALLOWED_ENDPOINTS=/api/models,/api/chat/completions,/ollama/api/chat,/ollama/api/tags

POSTGRES_PASSWORD_DEV=aiyo_password_change_me
POSTGRES_DB_DEV=aiyo_new_dev_db
POSTGRES_PASSWORD_PROD=aiyo_password_change_me
POSTGRES_DB_PROD=aiyo_new_prod_db

OLLAMA_MODEL=qwen3.5:9b
OLLAMA_TRAVEL_CHAT_MODEL=qwen3.5:9b
OLLAMA_TRIP_PLAN_MODEL=granite4.1:3b
OLLAMA_VIDEO_SUMMARY_MODEL=granite4.1:8b
OLLAMA_VIDEO_SUMMARY_FAST_MODEL=mistral-small:24b
OLLAMA_VIDEO_SUMMARY_FINAL_MODEL=granite4.1:8b
OLLAMA_LOCATION_MODEL=granite4.1:8b
VIDEO_EXTRACTION_MODE=simple-ollama
OLLAMA_TIMEOUT_MS=120000
OLLAMA_TIMEOUT_CAP_MS=600000
OLLAMA_TIMEOUT_RETRY_COUNT=1
OLLAMA_TIMEOUT_RETRY_DELAY_MS=400
OLLAMA_THINK=false
OLLAMA_VIDEO_THINK=true
OLLAMA_VIDEO_SEGMENT_JSON_POLISH=true
OLLAMA_VIDEO_LOCATION_JSON_FILTER=false
VIDEO_EXTRACTION_CHUNK_MAX_CHARS=12000
VIDEO_EXTRACTION_CHUNK_OVERLAP_CHARS=500
VIDEO_EXTRACTION_CHUNK_MAX_COUNT=8
VIDEO_EXTRACTION_CHUNK_CONCURRENCY=1
VIDEO_EXTRACTION_OPTIONAL_VERIFY=false

# Optional legacy fallback only during transition.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

MEM0_ENABLED=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APP_NAME=AIYO
YOUTUBE_API_KEY=
GOOGLE_MAPS_API_KEY=
TAVILY_API_KEY=
WEB_SEARCH_PROVIDER=auto
SERPER_API_KEY=
AIYO_WEB_SEARCH_MOCK=false
AI_WEB_SEARCH_ENABLED=true
AI_WEB_SEARCH_MAX_RESULTS=6
AI_WEB_SEARCH_REQUIRE_CITATIONS=true
TRAVEL_RESEARCH_PROVIDER_TIMEOUT_MS=12000
TRAVEL_SEARCH_CACHE_TTL_MS=300000

NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
NEXT_PUBLIC_ENABLE_MOCK_MAPS=false
ENABLE_MOCK_VIDEO_PROVIDER=false
ENABLE_MOCK_MAPS=false
VIDEO_PLACE_REQUIRE_VERIFICATION=true
VIDEO_PLACE_ALLOW_HEURISTIC_FALLBACK=false
VIDEO_PLACE_ENABLE_OLLAMA_CANDIDATES=true
VIDEO_PLACE_ENABLE_NOMINATIM=false
VIDEO_PLACE_MAX_CANDIDATES=24
VIDEO_PLACE_MAX_FINAL_PLACES=16
