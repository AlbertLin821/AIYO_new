{
  "name": "aiyo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build",
    "build:analyze": "next build --experimental-analyze",
    "analyze": "next experimental-analyze",
    "start": "next start",
    "lint": "eslint",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "test:video-scenario": "tsx scripts/test-video-analysis-scenario.ts",
    "benchmark:global-videos": "tsx scripts/benchmark-global-video-destinations.ts",
    "build:planning-destinations": "tsx scripts/build-planning-destination-catalog.ts",
    "rebuild:preloaded-index": "tsx scripts/rebuild-preloaded-index.ts",
    "seed:preloaded-videos": "tsx scripts/seed-preloaded-destination-videos.ts",
    "seed:preloaded-videos:refill": "tsx scripts/refill-preloaded-complete.ts",
    "seed:preloaded-videos:refill-api": "tsx scripts/refill-preloaded-complete.ts --refresh-search",
    "test:benchmark-quality": "tsx --test scripts/benchmarks/videoQualityChecks.test.ts",
    "test:video-migration": "npm test && npm run e2e:full-qa",
    "e2e": "playwright test",
    "test:e2e": "playwright test",
    "test:e2e:phase7": "playwright test tests/e2e/phase7-travel-agent-flow.spec.ts",
    "test:e2e:phase8": "playwright test tests/e2e/phase7-travel-agent-flow.spec.ts -g \"F–H|J\\.|K\\.\"",
    "test:e2e:live-ai": "playwright test tests/e2e/live-ai-generalization.spec.ts",
    "test:e2e:live-ai:itinerary": "playwright test tests/e2e/live-ai-itinerary-conversation.spec.ts",
    "test:e2e:live-ai:ef": "playwright test tests/e2e/live-ai-generalization.spec.ts -g \"E\\.|F\\.\"",
    "e2e:full-qa": "playwright test tests/e2e/full-user-travel-flow.spec.ts tests/e2e/video-summary-map-quality.spec.ts tests/e2e/itinerary-editor-flow.spec.ts --trace on",
    "e2e:ui": "playwright test --ui",
    "prisma:generate": "tsx scripts/run-with-env-local.ts prisma generate",
    "prisma:migrate:diff": "tsx scripts/run-with-env-local.ts prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script --output prisma/migrations/20260416_000001_phase3_init/migration.sql",
    "db:seed": "tsx scripts/run-with-env-local.ts tsx prisma/seed.ts",
    "db:clear-users": "tsx scripts/run-with-env-local.ts tsx prisma/clear-users.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/client": "^6.17.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.17.0",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.8.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "youtube-transcript": "^1.3.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^6.17.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx scripts/run-with-env-local.ts tsx prisma/seed.ts"
  }
}
